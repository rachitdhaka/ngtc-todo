# Copy to .env and fill in the OAuth values. .env is git-ignored.

# --- database ---
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo
POSTGRES_DB=todo

# --- app entry point (oauth2-proxy) ---
APP_PORT=4180

# --- OAuth (oauth2-proxy) ---
# Provider: github or google
OAUTH2_PROVIDER=github
# From your OAuth app registration. Callback URL to register:
#   http://localhost:4180/oauth2/callback
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
# 32 random bytes, generate with:
#   python3 -c 'import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
OAUTH2_COOKIE_SECRET=
# Restrict who can sign in, e.g. microland.com. * allows any account.
OAUTH2_EMAIL_DOMAINS=*
